config/agent.toml
config/target.toml
config/private.toml

# ==================================================
# MESSENGER PRIVATE DATA
# ==================================================
data/raw/*
data/processed/*
data/clusters/*
data/vector_db/*
data/training/*

# Giữ lại folder rỗng trên GitHub
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/clusters/.gitkeep
!data/vector_db/.gitkeep
!data/training/.gitkeep

# ==================================================
# Facebook / Messenger exports
